# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# Opt-in CUDA venv (docs/experiments/005-gpu-inference.md): a symlink to a
# venv on external storage, like truco-py's -- never the actual .venv, never
# committed.
.venv-cuda

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.benchmarks/

# Persisted game sessions (server/persistence.py) -- tied to the checkout
# that produced them, not meant to be shared or committed.
.catan-sessions/

# rl/train.py output: checkpoint .zip files and tensorboard event logs.
# Binary training artifacts, not source -- the evidence a PR carries is the
# stamped experiments/results/benchmark_rl_*.json, the same convention Phase 2
# and Phase 3 already use for benchmark_*.json.
rl_runs/
